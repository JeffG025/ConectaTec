<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.estudiante.grupos.EstudianteEscanearQrFragment">

    <!-- Preview de la cámara -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewEscanearQr"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Overlay oscuro arriba -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#A0000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/escanerCentro" />

    <!-- Overlay oscuro abajo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#A0000000"
        app:layout_constraintTop_toBottomOf="@id/escanerCentro"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Overlay oscuro izquierda -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A0000000"
        app:layout_constraintTop_toTopOf="@id/escanerCentro"
        app:layout_constraintBottom_toBottomOf="@id/escanerCentro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/escanerCentro" />

    <!-- Overlay oscuro derecha -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A0000000"
        app:layout_constraintTop_toTopOf="@id/escanerCentro"
        app:layout_constraintBottom_toBottomOf="@id/escanerCentro"
        app:layout_constraintStart_toEndOf="@id/escanerCentro"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Frame central del escáner -->
    <FrameLayout
        android:id="@+id/escanerCentro"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_scan_frame"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Header back -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnVolverEscanearEst"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/white"
            android:contentDescription="@string/cd_volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Escanea el QR del grupo"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Instrucciones inferiores -->
    <TextView
        android:id="@+id/tvInstruccionEscanear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:text="Apunta la cámara al código QR del grupo. La detección es automática."
        android:textColor="@color/white"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
